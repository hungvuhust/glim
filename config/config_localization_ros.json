{
    /*** Localization ROS Configuration ***/
    // --- Points config ---
    // keep_raw_points        : Keep raw points for extension modules
    //
    // --- IMU config ---
    // imu_time_offset        : Time offset for IMU data (in seconds)
    // points_time_offset     : Time offset for point cloud data (in seconds)
    // acc_scale              : Accelerometer scale factor (Set to 9.80665 for Livox sensors)
    //
    // --- TF config ---
    // imu_frame_id           : IMU frame ID
    // lidar_frame_id         : LiDAR frame ID
    // base_frame_id          : Base frame ID
    // map_frame_id           : Map frame ID (localization reference frame)
    // publish_imu2lidar      : If false, do not publish "imu -> lidar" TF
    // tf_time_offset         : Time offset for TF data (in seconds)
    //
    // --- Extension modules ---
    // extension_modules      : List of extension modules to load
    //
    // --- Topics ---
    // imu_topic              : IMU topic (optional, for future use)
    // points_topic           : Points topic (required for localization)
    // image_topic            : Image topic (optional, for future use)
    // initial_pose_topic     : Initial pose topic (required for initialization)
    //
    // --- Output Topics ---
    // pose_topic             : Output pose topic
    // pose_cov_topic         : Output pose with covariance topic
    // path_topic             : Output trajectory path topic
    //
    // --- QoS options ---
    // imu_qos                : QoS options for IMU topic subscription
    // points_qos             : QoS options for points topic subscription
    // image_qos              : QoS options for image topic subscription
    "glim_localization_ros": {
        // Points config
        "keep_raw_points": false,
        // IMU config
        "imu_time_offset": 0.0,
        "points_time_offset": 0.0,
        "acc_scale": 9.81,
        // TF config
        "imu_frame_id": "livox_frame",
        "lidar_frame_id": "livox_frame",
        "base_frame_id": "base_link",
        "map_frame_id": "map",
        "publish_imu2lidar": false,
        "tf_time_offset": 1e-6,
        // Extension modules (optional, e.g., for visualization)
        "extension_modules": [
            "libmemory_monitor.so",
            "libstandard_viewer.so",
            "librviz_viewer.so"
        ],
        // Input Topics
        "imu_topic": "/livox/imu",
        "points_topic": "/livox/lidar",
        "image_topic": "/image",
        "initial_pose_topic": "/initialpose",
        // Output Topics
        "pose_topic": "/localization/pose",
        "pose_cov_topic": "/localization/pose_cov",
        "path_topic": "/localization/path",
        // QoS options
        "imu_qos": {
            "profile": "sensor_data",
            "depth": 1000
        },
        "points_qos": {
            "profile": "sensor_data"
        },
        "image_qos": {
            "profile": "sensor_data"
        }
    }
}